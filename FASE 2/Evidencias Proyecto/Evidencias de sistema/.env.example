# Server Configuration
NODE_ENV=development
PORT=3000

# Cloud PostgreSQL Configuration (SaaS)
DATABASE_URL=postgresql://gestock_admin:gestock_secret_2026@localhost:5432/gestock_cloud_db
PGHOST=localhost
PGPORT=5432
PGUSER=gestock_admin
PGPASSWORD=gestock_secret_2026
PGDATABASE=gestock_cloud_db
PGSSL=false

# Local POS SQLite Configuration (Offline-First)
SQLITE_DB_PATH=./data/gestock_local_pos.sqlite
SQLITE_IN_MEMORY=false

# Security, Tokens & Authentication Enforcement
# En produccion es obligatorio: minimo 32 caracteres y distinto a este valor de ejemplo (el servidor no arranca si no)
JWT_SECRET=super_secret_jwt_key_gestock_2026_change_in_production
JWT_EXPIRATION=86400
# Usuarios iniciales
# - Fuera de produccion se crean admin@gestock.cl / admin123 y cajero@gestock.cl / cajero123 si no existen.
# - En produccion no se crean cuentas demo (salvo SEED_DEMO_USERS=true). Si el comercio no tiene administrador,
#   se crea uno con INITIAL_ADMIN_EMAIL / INITIAL_ADMIN_PASSWORD (minimo 8 caracteres).
# - Las contrasenas existentes nunca se sobrescriben al arrancar; se cambian con PUT /api/v1/auth/password.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
SEED_DEMO_USERS=false
# ENFORCE_AUTH: Controla la exigencia estricta de Bearer Token en rutas protegidas.
# - En producción (NODE_ENV=production): Se exige autenticación POR DEFECTO (seguro por diseño).
# - En desarrollo (NODE_ENV=development): Establecer en true para exigir token JWT en cada llamada.
# Si está en false en desarrollo, permite acceso libre a endpoints protegidos para pruebas rápidas.
ENFORCE_AUTH=true
# AUTH_DISABLED: Interruptor de emergencia solo para pruebas controladas en local (por defecto false).
AUTH_DISABLED=false

# Google AI Studio (OCR de facturas). Se saca en aistudio.google.com
GEMINI_API_KEY=
# opcional: modelos para el OCR, separados por coma y en orden de preferencia. Si uno devuelve
# 503 por saturacion se prueba el siguiente, en vez de insistir con el mismo.
# Medido el 14-10-2026 con una factura real: flash-lite respondio 3 de 3 en unos 4,4 s, mientras
# 3.6 y 3.8 devolvian 503 y 3.5 alternaba 503 con 429. Google deprecio dos versiones en cinco dias.
# Antes de esta lista, el OCR solo se usa si el extractor nativo de PDF no logro leer el documento.
GEMINI_MODELS=gemini-3.1-flash-lite,gemini-flash-latest,gemini-3.6-flash
# ENABLE_MOCK_OCR: unica via para habilitar el simulador de facturas. En true permite el fallback
# a mock cuando fallan Gemini y el extractor nativo de PDF; en false (o ausente) devuelve HTTP 422
# para no inventar compras ni proveedores. Dejarlo en true en desarrollo si se trabaja sin GEMINI_API_KEY.
# La bandera simulate_failure del cuerpo de la peticion solo surte efecto fuera de produccion.
ENABLE_MOCK_OCR=false

# Facturas: cola de pendientes de digitalizacion (RF-43) y respaldo documental (RF-46).
# El documento se guarda en el disco local Y en la nube (factura_ingresos.archivo_contenido):
# la ruta local no sirve de respaldo si se pierde el equipo del local. Una factura ingresada
# sin conexion se sube, con su proveedor y su documento, al sincronizar.
INVOICE_STORAGE_DIR=./data/facturas
INVOICE_MAX_FILE_MB=10
# Intentos de digitalizacion antes de derivar la factura a ingreso manual (estado FALLIDA_OCR)
INVOICE_MAX_OCR_ATTEMPTS=3


# Servidor de correo para el aviso automatico de reposicion (RF-19).
# Sin estas variables el sistema no despacha nada y lo informa: no marca las ordenes como
# enviadas ni devuelve exito. Las credenciales reales van en .env, que no se versiona.
# Para una cuenta de Gmail se usa una contrasena de aplicacion, no la del correo.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Remitente visible del aviso. Si se omite se usa SMTP_USER.
SMTP_FROM=
