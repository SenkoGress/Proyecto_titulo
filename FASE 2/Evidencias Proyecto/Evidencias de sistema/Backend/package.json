{
  "name": "gestock-backend",
  "version": "0.1.0",
  "description": "Gestock - Predictive Inventory Management System (Cloud SaaS & POS Offline-First)",
  "main": "electron/main.js",
  "scripts": {
    "build": "tsc && node scripts/copiar-migraciones.js",
    "start": "node dist/backend/src/index.js",
    "dev": "ts-node backend/src/index.ts",
    "test": "jest --runInBand --detectOpenHandles",
    "test:unit": "jest --config tests_unitarias/jest.unit.config.js --runInBand",
    "test:unit:backend": "jest --config tests_unitarias/jest.unit.config.js tests_unitarias/backend --runInBand",
    "test:unit:frontend": "jest --config tests_unitarias/jest.unit.config.js tests_unitarias/frontend --runInBand",
    "test:e2e:frontend": "node tests_e2e_frontend/ejecutar.mjs",
    "test:coverage": "jest --runInBand --coverage",
    "migrate:pg": "ts-node backend/src/database/postgres/run-migration.ts",
    "migrate:sqlite": "ts-node backend/src/database/sqlite/run-migration.ts",
    "test:coverage:total": "jest --config jest.coverage.config.js --runInBand",
    "build:frontend": "npm --prefix front-end run build",
    "build:desktop": "npm run build && npm run build:frontend",
    "electron:dev": "npm run build:desktop && electron .",
    "pack:dir": "npm run build:desktop && electron-builder --dir",
    "dist:win": "npm run build:desktop && electron-builder --win",
    "datos:demo": "ts-node backend/src/database/cargar-catalogo-demo.ts"
  },
  "keywords": [
    "inventory",
    "pos",
    "offline-first",
    "multi-tenant",
    "saas"
  ],
  "author": "Gestock Team",
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.3.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.13.3",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.9",
    "@types/nodemailer": "^8.0.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.11.11",
    "@types/uuid": "^10.0.0",
    "docx": "^9.7.1",
    "electron": "^44.10.2",
    "electron-builder": "^26.18.0",
    "jest": "^30.5.2",
    "pg-mem": "^3.0.4",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  },
  "allowScripts": {
    "electron@44.10.2": true
  },
  "build": {
    "appId": "cl.gestock.pos",
    "productName": "GesTock",
    "copyright": "GesTock",
    "directories": {
      "output": "release",
      "buildResources": "electron/recursos"
    },
    "files": [
      "dist/backend/**/*",
      "front-end/dist/**/*",
      "semillas/**/*",
      "electron/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "electron/recursos/icono.ico",
      "artifactName": "GesTock-${version}-instalador.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GesTock"
    }
  }
}
