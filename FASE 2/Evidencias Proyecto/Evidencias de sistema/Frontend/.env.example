# .env.example
# copia este archivo como .env.development y ajusta los valores

VITE_BACKEND_URL=http://localhost:3000
VITE_TENANT_ID=00000000-0000-0000-0000-000000000001
VITE_USUARIO_ID=00000000-0000-0000-0000-000000000002
VITE_CAJERO_NOMBRE=Admin Demo
VITE_CAJERO_ROL=Cajero Turno
VITE_DEVICE_ID=POS-LOCAL-DEVICE-01
# Va junto con ENFORCE_AUTH del backend: si el servidor exige token y la interfaz no lo manda,
# toda ruta protegida responde 401 y la aplicacion no abre.
VITE_AUTH_ACTIVA=true
